                    >
                      <Inbox className="w-3.5 h-3.5" />
                      <span>Primary</span>
                    </div>
                    <div className="hidden md:flex items-center gap-2 px-3 py-1.5 text-neutral-400 font-medium text-xs">
                      <Tag className="w-3.5 h-3.5" />
                      <span>Promotions</span>
                    </div>
                    <div className="hidden md:flex items-center gap-2 px-3 py-1.5 text-neutral-400 font-medium text-xs">
                      <Archive className="w-3.5 h-3.5" />
                      <span>Updates</span>
                    </div>
                  </div>

                  <span className="text-[11px] font-mono text-neutral-400">
                    {viewState === 'after' ? `1–50 of ${counts.inbox.toLocaleString()}` : `1–50 of ${counts.spam.toLocaleString()}`}
                  </span>
                </div>

                {/* Staggered, Multi-Phase Framer Motion Email List Container */}
                <motion.div
                  layout
                  className="divide-y divide-black/[0.04] dark:divide-white/[0.06] pb-3"
                >
                  <AnimatePresence initial={false} mode="popLayout">
                    {displayedEmails.map((email, itemIdx) => {
                      const isBaseCard = email.type === 'base';
                      const isPhase2 = email.type === 'phase2';
                      const isPhase3 = email.type === 'phase3';
                      const isGreenNew = isPhase2 || isPhase3;

                      // Strikethrough state using item position in the combined spam list
                      const allSpamList = [...BASE_EMAILS, ...BEFORE_SPAM_EXTRA_EMAILS];
                      const spamIndex = allSpamList.findIndex((b) => b.id === email.id);
                      const isStruck =
                        viewState === 'before' &&
                        (struckIndices.has(spamIndex) || struckIndices.size === 0);

                      const isBlurred = itemIdx >= 4;
                      const depth = itemIdx - 3;
                      const blurPx = isBlurred ? Math.min(depth * 1.5, 6) : 0;
                      const opacityVal = isBlurred ? Math.max(0.72 - (depth - 1) * 0.16, 0.08) : 1;

                      return (
                        <motion.div
                          key={email.id}
                          layout="position"
                          initial={
                            isGreenNew
                              ? { opacity: 0, x: 45, scale: 0.96, height: 0 }
                              : { opacity: 0 }
                          }
                          animate={{
                            opacity: opacityVal,
                            x: 0,
                            scale: 1,
                            height: 'auto',
                          }}
                          exit={{
                            opacity: 0,
                            x: -45,
                            scale: 0.95,
                            height: 0,
                          }}
                          transition={{
                            type: 'spring',
                            stiffness: isPhase3 ? 310 + (itemIdx % 3) * 28 : isPhase2 ? 350 + (itemIdx % 3) * 22 : 390,
                            damping: isPhase3 ? 26 + (itemIdx % 3) * 2.5 : isPhase2 ? 28 + (itemIdx % 3) * 2 : 32,
                            mass: 0.85,
                            delay: isPhase3 ? 0.08 * (itemIdx + 1) : isPhase2 ? 0.06 * (itemIdx + 1) : 0,
                            opacity: { duration: 0.28 },
                          }}
                          style={{
                            filter: isBlurred ? `blur(${blurPx}px)` : 'none',
                            userSelect: isBlurred ? 'none' : 'auto',
                            pointerEvents: isBlurred && depth > 2 ? 'none' : 'auto',
                            transition: 'filter 0.35s ease, opacity 0.35s ease',
                          }}
                          className={`group px-3 sm:px-4 py-2.5 flex items-center gap-2 sm:gap-3 text-xs transition-colors duration-200 cursor-pointer ${
                            isStruck
                              ? 'bg-rose-500/[0.05] hover:bg-rose-500/[0.09]'
                              : isGreenNew
                              ? isLightMode
                                ? 'bg-emerald-50/70 border-l-4 border-emerald-500 hover:bg-emerald-50'
                                : 'bg-emerald-950/20 border-l-4 border-emerald-500 hover:bg-emerald-950/30'
                              : isLightMode
                              ? 'bg-white hover:bg-neutral-50'
                              : 'bg-[#111114] hover:bg-white/[0.03]'
                          }`}
                        >
                          <Square className="w-3.5 h-3.5 text-neutral-400 flex-shrink-0 group-hover:text-black dark:group-hover:text-white" />
                          <Star
                            className={`w-3.5 h-3.5 flex-shrink-0 ${
                              isGreenNew ? 'text-emerald-400 fill-emerald-400/20' : 'text-neutral-400'
                            }`}
                          />

                          {/* Sender */}
                          <div
                            className={`w-24 xs:w-32 sm:w-52 flex-shrink-0 font-bold truncate flex items-center gap-1.5 transition-all duration-200 ${
                              isStruck
                                ? 'text-rose-600 dark:text-rose-400 line-through opacity-75'
                                : isGreenNew
                                ? 'text-emerald-600 dark:text-emerald-400'
                                : isLightMode
                                ? 'text-black'
                                : 'text-white'
                            }`}
                          >
                            <span className="truncate">{email.sender}</span>
                            {!isStruck && viewState === 'after' && (
                              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 inline-block flex-shrink-0" />
                            )}
                          </div>

                          {/* Subject + Snippet */}
                          <div className="flex-1 min-w-0 flex items-center gap-2 truncate">
                            <span
                              className={`font-semibold truncate transition-all duration-200 ${
                                isStruck
                                  ? 'text-rose-600/80 dark:text-rose-300/80 line-through'
                                  : isLightMode
                                  ? 'text-neutral-900'
                                  : 'text-neutral-100'
                              }`}
                            >
                              {email.subject}
                            </span>
                            <span
                              className={`font-normal truncate hidden md:inline transition-all duration-200 ${
                                isStruck ? 'text-rose-400/60 line-through' : 'text-neutral-400'
                              }`}
                            >
                              — {email.snippet}
                            </span>
                          </div>

                          {/* Green Badge for Newly Injected Phase 2 / Phase 3 Cards */}
                          {isGreenNew && (
                            <span className="hidden lg:inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30 flex-shrink-0">
                              {isPhase3 ? 'SURGE INGRESS' : 'RECOVERED'}
                            </span>
                          )}

                          {/* Attachment Pill */}
                          {email.hasAttachment && (
                            <div
                              className={`hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full border text-[10px] font-mono flex-shrink-0 ${
                                isLightMode
                                  ? 'bg-neutral-100 border-black/10 text-neutral-700'
                                  : 'bg-white/5 border-white/10 text-neutral-300'
                              }`}
                            >
                              <Paperclip className="w-3 h-3 text-neutral-400" />
                              <span className="truncate max-w-[120px]">{email.hasAttachment}</span>
                            </div>
                          )}

                          {/* Timestamp */}
                          <span
                            className={`font-mono text-[11px] font-bold flex-shrink-0 whitespace-nowrap ${
                              isStruck
                                ? 'text-rose-500/70'
                                : isGreenNew
                                ? 'text-emerald-500'
                                : isLightMode
                                ? 'text-black'
                                : 'text-white'
                            }`}
                          >
                            {email.time}
                          </span>
                        </motion.div>
                      );
                    })}
                  </AnimatePresence>
                </motion.div>

                {/* Bottom Gradient Fade Blur Overlay covering bottom ~3 cards smoothly in both Before & After */}
                <div
                  className="pointer-events-none absolute bottom-0 left-0 right-0 h-32 sm:h-40 z-20 transition-opacity duration-300"
                  style={{
                    background: isLightMode
                      ? 'linear-gradient(to top, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.85) 35%, rgba(255, 255, 255, 0) 100%)'
