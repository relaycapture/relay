              </div>

              {/* Bottom Status Bar: Authentic Gmail Workspace 5TB Storage Meter */}
              <div
                className={`px-4 sm:px-5 py-2.5 border-t flex flex-wrap items-center justify-between gap-3 text-xs font-sans relative z-30 ${
                  isLightMode ? 'bg-[#f6f8fc] border-black/[0.06] text-neutral-600' : 'bg-[#141417] border-white/[0.06] text-neutral-400'
                }`}
              >
                <div className="flex items-center gap-3">
                  {/* Storage Progress Bar */}
                  <div className="w-24 sm:w-32 h-1.5 rounded-full bg-black/10 dark:bg-white/10 overflow-hidden">
