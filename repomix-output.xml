      {/* Hero Content Overlay */}
      <div className="relative z-10 max-w-5xl mx-auto w-full flex flex-col items-center justify-center text-center my-auto">
        {/* Staggered Apple-Inspired Typography */}
        <h1
          className={`font-sans text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-[-0.04em] leading-[1.12] sm:leading-[1.08] mb-5 sm:mb-8 text-center ${
            isLightMode ? 'text-[#1d1d1f]' : 'text-white'
          }`}
        >
          <span className="block mb-1.5 sm:mb-3">Your domain is speaking.</span>
          <span className={`block text-center ${isLightMode ? 'text-neutral-700' : 'text-neutral-300'}`}>
            Do you know what it says?
          </span>
        </h1>

