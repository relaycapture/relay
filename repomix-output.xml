                    RECOMMENDED
                  </div>
                )}

                <div className="relative z-10">
                  {/* Top Tier Info */}
                  <div className="mb-6">
                    <span className={`font-mono text-xs uppercase tracking-wider block mb-1 ${
                      isLightMode ? 'text-neutral-500' : 'text-neutral-400'
                    }`}>
                      {tier.period}
