'use client'

import { useState, useEffect, useRef } from 'react';
import { Terminal, CheckCircle2, FileText, Shield, Globe, Zap, Key } from 'lucide-react';

const TRIANGLE = 'polygon(50% 0%, 100% 100%, 0% 100%)';

export function ProgrammaticDemoLoop({ isLightMode }: { isLightMode?: boolean }) {
  const [step, setStep] = useState(0);
  const [typedText, setTypedText] = useState('');
  const [cursorPos, setCursorPos] = useState({ x: 18, y: 88, clicked: false });
  const [progressPercent, setProgressPercent] = useState(0);
  const sectionRef = useRef<HTMLElement>(null);

  const targetDomain = 'auth.stripe-internal.io';

  useEffect(() => {
    let intervals: NodeJS.Timeout[] = [];
    let timeouts: NodeJS.Timeout[] = [];
    let isVisible = false;

    const clearAll = () => {
      intervals.forEach(clearInterval);
      timeouts.forEach(clearTimeout);
      intervals = [];
      timeouts = [];
    };

    const runTimeline = () => {
      clearAll();
      if (!isVisible) return;
      setStep(0);
      setTypedText('');
      setProgressPercent(0);
      setCursorPos({ x: 20, y: 85, clicked: false });

      // Step 1: Cursor moves to input, begins typing smoothly
      timeouts.push(
        setTimeout(() => {
          if (!isVisible) return;
          setStep(1);
          setCursorPos({ x: 34, y: 26, clicked: false });

          let curr = '';
          for (let i = 0; i < targetDomain.length; i++) {
            timeouts.push(
              setTimeout(() => {
                if (!isVisible) return;
                curr += targetDomain[i];
                setTypedText(curr);
              }, i * 90) // Realistic typing pace
            );
          }
        }, 1200)
      );

      // Step 2: Cursor glides to Resolve button and clicks with ripple
      timeouts.push(
        setTimeout(() => {
          if (!isVisible) return;
          setCursorPos({ x: 88, y: 26, clicked: true });
          setStep(2);
        }, 3800)
      );

      // Step 3: Probing initiation and progress bar starts smoothly
      timeouts.push(
        setTimeout(() => {
          if (!isVisible) return;
          setCursorPos({ x: 50, y: 55, clicked: false });
          setStep(3);

          let p = 0;
          const pInt = setInterval(() => {
            if (!isVisible) {
              clearInterval(pInt);
              return;
            }
            p += 2;
            if (p <= 100) setProgressPercent(p);
            else clearInterval(pInt);
          }, 60);
          intervals.push(pInt);
        }, 4800)
      );

      // Step 4: SPF & DKIM verified stage
      timeouts.push(
        setTimeout(() => {
          if (!isVisible) return;
          setCursorPos({ x: 65, y: 48, clicked: false });
          setStep(4);
        }, 8500)
      );

      // Step 5: DMARC & Composite Score generated
      timeouts.push(
        setTimeout(() => {
          if (!isVisible) return;
          setCursorPos({ x: 72, y: 72, clicked: false });
          setStep(5);
        }, 11500)
      );

      // Step 6: Cursor glides to Download Bundle CTA and clicks
      timeouts.push(
        setTimeout(() => {
          if (!isVisible) return;
          setCursorPos({ x: 78, y: 78, clicked: true });
          setStep(6);
        }, 14500)
      );

      // Reset loop after 18.5 seconds (slower, longer, realistic)
      timeouts.push(
        setTimeout(() => {
          if (isVisible) runTimeline();
        }, 18500)
      );
    };

    // Viewport-gated Intersection Observer (Only runs when section is visible)
    let observer: IntersectionObserver | null = null;
    if (sectionRef.current) {
      observer = new IntersectionObserver(
        (entries) => {
          const [entry] = entries;
          const visible = Boolean(entry?.isIntersecting);
          if (visible !== isVisible) {
            isVisible = visible;
            if (isVisible) {
              runTimeline();
            } else {
              clearAll();
            }
          }
        },
        { threshold: 0.1 }
      );
      observer.observe(sectionRef.current);
    }

    return () => {
      clearAll();
      observer?.disconnect();
    };
  }, []);

  return (
    <section
      ref={sectionRef}
      id="programmatic-demo"
      className="relative min-h-screen py-20 sm:py-28 md:py-36 px-4 sm:px-8 md:px-12 lg:px-24 overflow-hidden z-10 section-content-auto"
    >
      {/* Background Soft Glow */}
      <div className="absolute inset-0 pointer-events-none overflow-hidden opacity-30 z-0" aria-hidden="true">
        <div
          className={`absolute top-1/3 right-1/4 w-[50vw] h-[50vw] rounded-full blur-[140px] ${isLightMode ? 'bg-neutral-200' : 'bg-white/5'
            }`}
        />
      </div>

      <div className="relative z-10 max-w-5xl mx-auto">
        {/* Section Heading */}
        <div className="text-center max-w-2xl mx-auto mb-8 sm:mb-14">
          <h2
            className={`text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold font-sans tracking-[-0.035em] leading-[1.15] mb-4 ${isLightMode ? 'text-[#1d1d1f]' : 'text-white'
              }`}
          >
            Automated deep probe.
          </h2>
          <p className={`text-xs sm:text-base md:text-lg font-normal leading-relaxed ${isLightMode ? 'text-neutral-600' : 'text-neutral-400'}`}>
            Watch our engine resolve root authoritative nameservers, evaluate SPF mechanics, verify 2048-bit DKIM keys, and calculate DMARC policy enforcement live.
          </p>
        </div>

        {/* Self-contained Stripe-Inspired Terminal Simulation */}
        <div
          className={`relative max-w-3xl mx-auto rounded-2xl sm:rounded-3xl border overflow-hidden shadow-2xl p-4 sm:p-6 md:p-8 min-h-[440px] select-none rc-grain-surface transition-all duration-300 ${isLightMode
              ? 'bg-white/90 border-black/10 shadow-[0_20px_60px_rgba(0,0,0,0.06)]'
              : 'bg-[#0E0E12]/90 border-white/15 shadow-[0_25px_80px_rgba(0,0,0,0.6)]'
            }`}
        >
          {/* Header Bar */}
          <div
            className={`flex items-center justify-between border-b pb-4 mb-6 ${isLightMode ? 'border-black/10' : 'border-white/10'
              }`}
          >
            <div className="flex items-center gap-3">
              <span className={`w-2.5 h-2.5 rounded-full ${isLightMode ? 'bg-black' : 'bg-white'} animate-pulse`} />
              <span className={`font-mono text-xs font-semibold uppercase tracking-wider ${isLightMode ? 'text-black' : 'text-white'}`}>
                RELAY ENGINE CORE // SCANNER RUNTIME
              </span>
            </div>
            <div className="flex items-center gap-2 font-mono text-[11px] text-neutral-400">
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-500" />
              <span>Cloudflare DoH 1.1.1.1 JSON (v2.4)</span>
            </div>
          </div>

          {/* Progress Bar Header for Step 3+ */}
          {step >= 3 && (
            <div className="mb-4 space-y-1">
