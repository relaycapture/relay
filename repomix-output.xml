              onClick={() => handleToggle('after')}
              className={`rc-grain-surface flex-1 sm:flex-initial px-3 sm:px-5 py-3 sm:py-2.5 rounded-xl text-[11px] sm:text-sm font-semibold transition-all flex items-center justify-center gap-1.5 sm:gap-2 truncate min-h-[48px] ${
                viewState === 'after'
                  ? 'bg-emerald-500/20 text-emerald-500 border border-emerald-500/40 shadow-sm'
                  : isLightMode
                  ? 'text-neutral-600 hover:text-black'
                  : 'text-neutral-400 hover:text-white'
              }`}
            >
              <ShieldCheck className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-500 flex-shrink-0" />
              <span className="truncate">
                <span className="sm:hidden">AFTER (Enforced)</span>
                <span className="hidden sm:inline">AFTER: Cryptographic Enforcement</span>
              </span>
            </button>
          </div>
        </div>

        {/* Gmail Authentic UI Frame */}
        <div
          id="gmail-simulation-window"
          className={`rc-grain-surface rounded-2xl sm:rounded-3xl border shadow-2xl overflow-hidden transition-all duration-300 relative w-full max-w-full ${
            isLightMode
              ? 'bg-[#ffffff] border-black/10 shadow-[0_20px_60px_rgba(0,0,0,0.08)]'
