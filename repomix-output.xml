<file path="src/components/sections/financial-leakage.tsx">
'use client'

import { useState, useEffect, useMemo, useRef } from 'react';
import { ScanResult } from '../../types';
import { NumberTicker } from '../number-ticker';

interface FinancialLeakageProps {
  scanResult?: ScanResult | null;
  currentDomain?: string | null;
  lastScannedTime?: Date | null;
  isLightMode?: boolean;
  isLivePreview?: boolean;
}

// 12-point exact topology normalized from user reference image
// Points: [low start, steep rise, slight rise, steep rise, Peak 1, slope drop, slope drop, trough dip, Peak 2, slope drop, slight dip, Peak 3]
const REFERENCE_TOPOLOGY = [
  0.08, // P1 (low start)
  0.38, // P2 (steep rise)
  0.44, // P3 (slight rise, Q1)
  0.64, // P4 (steep rise)
  0.96, // P5 (Peak 1)
  0.72, // P6 (slope drop, Q2)
  0.52, // P7 (slope drop)
  0.38, // P8 (trough dip)
  0.88, // P9 (Peak 2, Q3)
  0.66, // P10 (drop)
  0.60, // P11 (slight dip)
  0.92, // P12 (Peak 3, Q4)
];

const SUM_REFERENCE_TOPOLOGY = REFERENCE_TOPOLOGY.reduce((acc, v) => acc + v, 0); // 7.18

// Fixed $40,000 ceiling for immutable, constant axes
const FIXED_MAX_Y = 40000;

export function FinancialLeakage({
  scanResult,
  currentDomain,
  lastScannedTime,
  isLightMode,
  isLivePreview = false,
}: FinancialLeakageProps) {
  // Input parameters with requested defaults:
  // Monthly Outbound: default 10,000 (min 1,000, max 100,000)
  // Quarantine / Spam Rate: default 35% (min 1%, max 65%)
  // Value per Conversion: default $3,500 (min $100, max $50,000)
  const [outboundVolume, setOutboundVolume] = useState<number>(10000);
  const [bounceRate, setBounceRate] = useState<number>(35);
  const [dealValue, setDealValue] = useState<number>(3500);
  const [hoveredIndex, setHoveredIndex] = useState<number | null>(null);

  useEffect(() => {
    if (scanResult && scanResult.summary) {
      setBounceRate(scanResult.summary.quarantineRiskPct || 35);
    }
  }, [scanResult]);

  // Real Mathematical Calculations matching exact formula specifications:
  // 1. Quarantined Outbound = Monthly Outbound * Spam Rate
  // 2. Monthly Revenue Leakage = Quarantined Outbound * 0.0015 * Value per Conversion
  // 3. Annualized Pipeline Risk = Monthly Revenue Leakage * 12
  const quarantinedMessages = Math.round(outboundVolume * (bounceRate / 100));
  const monthlyRevenueLeakage = Math.round(quarantinedMessages * 0.0015 * dealValue);
  const annualLeakage = monthlyRevenueLeakage * 12;

  // Severity Status & Color Triggers:
  // Trigger 1: When Spam Rate is below 10% -> Green (Healthy)
  // Trigger 2: When Spam Rate hits 11% to 24% -> Yellow/Amber (Uh oh...)
  // Trigger 3: When Spam Rate hits 25% or higher -> Aggressive Red (Blacklisted)
  const severityStatus = useMemo(() => {
    if (bounceRate <= 10) {
      return {
        label: 'Healthy',
        color: '#10b981', // Green
        badgeBg: isLightMode ? 'rgba(16, 185, 129, 0.12)' : 'rgba(16, 185, 129, 0.18)',
        badgeText: isLightMode ? '#047857' : '#34d399',
        badgeBorder: 'rgba(16, 185, 129, 0.3)',
      };
    } else if (bounceRate <= 24) {
      return {
        label: 'Uh oh...',
        color: '#f59e0b', // Yellow / Amber
        badgeBg: isLightMode ? 'rgba(245, 158, 11, 0.15)' : 'rgba(245, 158, 11, 0.20)',
        badgeText: isLightMode ? '#b45309' : '#fbbf24',
        badgeBorder: 'rgba(245, 158, 11, 0.35)',
      };
    } else {
      return {
        label: 'Blacklisted',
        color: '#ef4444', // Aggressive Red
        badgeBg: isLightMode ? 'rgba(239, 68, 68, 0.15)' : 'rgba(239, 68, 68, 0.22)',
        badgeText: isLightMode ? '#b91c1c' : '#f87171',
        badgeBorder: 'rgba(239, 68, 68, 0.35)',
      };
    }
  }, [bounceRate, isLightMode]);

  // Determine theme color for cards & graph based on triggers
  const themeColor = useMemo(() => {
    if (bounceRate <= 10) {
      return {
        stroke: '#10b981', // Vibrant Green
        fill: 'rgba(16, 185, 129, 0.12)',
        glow: 'rgba(16, 185, 129, 0.45)',
        dotBorder: '#059669',
        accentHex: '#10b981',
      };
    } else if (bounceRate <= 24) {
      return {
        stroke: '#f59e0b', // Yellow / Amber
        fill: 'rgba(245, 158, 11, 0.15)',
        glow: 'rgba(245, 158, 11, 0.45)',
        dotBorder: '#d97706',
        accentHex: '#f59e0b',
      };
    } else {
      return {
        stroke: '#ef4444', // Aggressive Red
        fill: 'rgba(239, 68, 68, 0.2)',
        glow: 'rgba(239, 68, 68, 0.5)',
        dotBorder: '#dc2626',
        accentHex: '#ef4444',
      };
    }
  }, [bounceRate]);

  // 12-Month Mathematical Data Engine:
  // Each node represents that month's compound reputation decay.
  // The sum of all 12 nodes EXACTLY matches the Annualized Pipeline Risk (annualLeakage).
  const graphPointsData = useMemo(() => {
    const monthNames = [
      'Month 1 (Jan)',
      'Month 2 (Feb)',
      'Month 3 (Mar)',
      'Month 4 (Apr)',
      'Month 5 (May)',
      'Month 6 (Jun)',
      'Month 7 (Jul)',
      'Month 8 (Aug)',
      'Month 9 (Sep)',
      'Month 10 (Oct)',
      'Month 11 (Nov)',
      'Month 12 (Dec)',
    ];

    // Compute exact monthly distribution matching annual total
    const computedLosses: number[] = [];
    let runningSum = 0;

    for (let i = 0; i < 12; i++) {
      if (i === 11) {
        // Last month absorbs remainder so sum(M1..M12) === annualLeakage to the exact dollar
        const remainder = Math.max(annualLeakage - runningSum, 0);
        computedLosses.push(remainder);
      } else {
        const weight = REFERENCE_TOPOLOGY[i] / SUM_REFERENCE_TOPOLOGY;
        const loss = Math.round(annualLeakage * weight);
        computedLosses.push(loss);
        runningSum += loss;
      }
    }

    return computedLosses.map((monthlyLoss, i) => {
      return {
        index: i,
        monthNumber: i + 1,
        label: monthNames[i],
        monthlyLoss,
        isQuarterNode: i === 2 || i === 5 || i === 8 || i === 11,
        quarterLabel: i === 2 ? 'Q1' : i === 5 ? 'Q2' : i === 8 ? 'Q3' : i === 11 ? 'Q4' : null,
      };
    });
  }, [annualLeakage]);

  // Fixed static Y-axis ticks: 0, $10K, $20K, $30K, $40K
  const yTicks = [
    { pct: 0.0, label: '0', isTop: false },
    { pct: 0.25, label: '$10K', isTop: false },
    { pct: 0.50, label: '$20K', isTop: false },
    { pct: 0.75, label: '$30K', isTop: false },
    { pct: 1.00, label: '$40K', isTop: true },
  ];

  // SVG Canvas dimensions
  const svgWidth = 820;
  const svgHeight = 270;
  const padding = { top: 28, right: 35, bottom: 45, left: 65 };
  const graphWidth = svgWidth - padding.left - padding.right;
  const graphHeight = svgHeight - padding.top - padding.bottom;

  // Compute SVG Coordinates for all 12 points
  const points = useMemo(() => {
    return graphPointsData.map((d, i) => {
      const x = padding.left + (i / (graphPointsData.length - 1)) * graphWidth;
      const normalizedRatio = Math.min(d.monthlyLoss / FIXED_MAX_Y, 1);
      const y = padding.top + graphHeight - normalizedRatio * graphHeight;
      return { x, y, ...d };
    });
  }, [graphPointsData, graphWidth, graphHeight, padding.left, padding.top]);

  // Polyline path connecting all 12 points
  const polylinePath = useMemo(() => {
    if (points.length === 0) return '';
    return points.map((p, idx) => `${idx === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
  }, [points]);

  // Area Fill path under polyline
  const areaPath = useMemo(() => {
    if (!polylinePath || points.length === 0) return '';
    const bottomY = padding.top + graphHeight;
    const lastX = points[points.length - 1].x;
    const firstX = points[0].x;
    return `${polylinePath} L ${lastX} ${bottomY} L ${firstX} ${bottomY} Z`;
  }, [polylinePath, points, padding.top, graphHeight]);

  // Baseline zero line
  const baselinePath = useMemo(() => {
    const bottomY = padding.top + graphHeight;
    return `M ${padding.left} ${bottomY} L ${padding.left + graphWidth} ${bottomY}`;
  }, [padding.left, padding.top, graphHeight, graphWidth]);

  const svgRef = useRef<SVGSVGElement | null>(null);

  const handleMouseMove = (e: React.MouseEvent<SVGSVGElement>) => {
    if (!svgRef.current) return;
    const rect = svgRef.current.getBoundingClientRect();
    const mouseX = ((e.clientX - rect.left) / rect.width) * svgWidth;

    let closestIdx = 0;
    let minDist = Infinity;
    points.forEach((p, idx) => {
      const dist = Math.abs(p.x - mouseX);
      if (dist < minDist) {
        minDist = dist;
        closestIdx = idx;
      }
    });
    setHoveredIndex(closestIdx);
  };

  const activePoint = hoveredIndex !== null ? points[hoveredIndex] : points[points.length - 1];

  return (
    <section
      id="financial-leakage"
      className={`relative px-4 sm:px-8 md:px-12 lg:px-24 overflow-hidden z-10 ${
        isLivePreview ? 'py-6' : 'py-20 sm:py-28 md:py-36 section-content-auto'
      }`}
    >
      <div className="relative z-10 max-w-7xl mx-auto">
        {/* Section Header */}
        <div className="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
          <h2
            className={`text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.035em] leading-[1.15] mb-3 ${
              isLightMode ? 'text-[#1d1d1f]' : 'text-white'
            }`}
          >
            Email risk rarely arrives with a warning.
          </h2>
          <p
            className={`text-xs sm:text-base md:text-lg font-normal leading-relaxed max-w-2xl mx-auto ${
              isLightMode ? 'text-neutral-600' : 'text-neutral-400'
            }`}
          >
            It appears as lost replies, rejected invoices, impersonated executives, and a sender reputation that takes months to rebuild.
          </p>
        </div>

        {/* Interactive 12-Node Line Graph Card Container */}
        <div className="w-full max-w-5xl mx-auto mb-6 sm:mb-8">
          <div
            className={`rc-grain-surface p-3.5 sm:p-6 md:p-7 rounded-2xl sm:rounded-3xl border backdrop-blur-xl transition-all duration-300 relative overflow-hidden flex flex-col justify-between min-h-[280px] sm:min-h-[340px] shadow-xl ${
              isLightMode
                ? 'bg-black/[0.015] border-black/[0.08]'
                : 'bg-white/[0.02] border-white/[0.08]'
            }`}
          >
              {/* Header: Synced Domain with Live Status Dot & Severity Badge */}
              <div className="flex flex-wrap items-center justify-between gap-2 mb-2 sm:mb-3 text-xs sm:text-sm font-mono border-b border-black/[0.06] dark:border-white/[0.08] pb-2.5 sm:pb-3">
                {currentDomain || scanResult?.domain ? (
                  <div className="flex items-center gap-2 flex-wrap">
                    <span
                      className="w-2.5 h-2.5 rounded-full inline-block animate-pulse flex-shrink-0"
                      style={{ backgroundColor: themeColor.stroke, boxShadow: `0 0 10px ${themeColor.glow}` }}
                    />
                    <span className={`font-mono font-bold text-xs sm:text-sm tracking-wider uppercase ${
                      isLightMode ? 'text-black' : 'text-white'
                    }`}>
                      {currentDomain || scanResult?.domain}
                    </span>
                    <span className={`text-[10.5px] font-mono ${isLightMode ? 'text-neutral-500' : 'text-neutral-400'}`}>
                      • Last scanned: {lastScannedTime ? lastScannedTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : 'Just now'}
                    </span>
                  </div>
                ) : (
                  <div className="flex items-center gap-2">
                    <span
                      className={`w-2 h-2 rounded-full inline-block flex-shrink-0 ${isLightMode ? 'bg-neutral-300' : 'bg-neutral-600'}`}
                    />
                    <span className={`font-mono text-xs sm:text-sm ${
                      isLightMode ? 'text-neutral-400' : 'text-neutral-500'
                    }`}>
                      Run live scan above to see results
                    </span>
                  </div>
                )}

                {/* Colored Status Label: Green = Healthy, Yellow = Uh oh..., Red = Blacklisted */}
                <div
                  className="px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[10px] sm:text-xs font-mono font-bold tracking-wide border transition-all"
                  style={{
                    backgroundColor: (currentDomain || scanResult?.domain) ? severityStatus.badgeBg : (isLightMode ? 'rgba(0,0,0,0.04)' : 'rgba(255,255,255,0.05)'),
                    color: (currentDomain || scanResult?.domain) ? severityStatus.badgeText : (isLightMode ? 'rgba(0,0,0,0.5)' : 'rgba(255,255,255,0.5)'),
                    borderColor: (currentDomain || scanResult?.domain) ? severityStatus.badgeBorder : (isLightMode ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.1)'),
                  }}
                >
                  ● {(currentDomain || scanResult?.domain) ? severityStatus.label : 'Awaiting Scan'}
                </div>
              </div>

              {/* 12-Node High-Precision Reference Topology Polyline SVG */}
              <div className="w-full relative my-auto">
                <svg
                  ref={svgRef}
                  viewBox={`0 0 ${svgWidth} ${svgHeight}`}
                  className="w-full h-auto overflow-visible cursor-crosshair select-none"
                  onMouseMove={handleMouseMove}
                  onMouseLeave={() => setHoveredIndex(null)}
                >
                  <defs>
                    {/* Dynamic Shaded Area Fill */}
                    <linearGradient id="asymmetricFill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stopColor={themeColor.stroke} stopOpacity={isLightMode ? '0.18' : '0.22'} />
                      <stop offset="60%" stopColor={themeColor.stroke} stopOpacity={isLightMode ? '0.06' : '0.08'} />
                      <stop offset="100%" stopColor={themeColor.stroke} stopOpacity="0.0" />
                    </linearGradient>

                    {/* Node Glow Filter */}
                    <filter id="pointGlow" x="-30%" y="-30%" width="160%" height="160%">
                      <feGaussianBlur stdDeviation="3" result="coloredBlur" />
                      <feMerge>
                        <feMergeNode in="coloredBlur" />
                        <feMergeNode in="SourceGraphic" />
                      </feMerge>
                    </filter>
                  </defs>

                  {/* Fixed Y-Axis Gridlines & Readable Ticks: 0, $10K, $20K, $30K, $40K */}
                  {yTicks.map((grid, idx) => {
                    const y = padding.top + graphHeight * (1 - grid.pct);
                    return (
                      <g key={`y-grid-${idx}`}>
                        <line
                          x1={padding.left}
                          y1={y}
                          x2={padding.left + graphWidth}
                          y2={y}
                          stroke={isLightMode ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.06)'}
                          strokeDasharray="3 3"
                        />
                        <text
                          x={padding.left - 10}
                          y={y + (grid.isTop ? 4 : 3)}
                          textAnchor="end"
                          className={`font-mono select-none ${
                            grid.isTop ? 'text-[11.5px] font-bold' : 'text-[10px] font-medium'
                          }`}
                          fill={
                            grid.isTop
                              ? isLightMode
                                ? 'rgba(0,0,0,0.95)'
                                : '#ffffff'
                              : isLightMode
                              ? 'rgba(0,0,0,0.45)'
                              : 'rgba(255,255,255,0.45)'
                          }
                        >
                          {grid.label}
                        </text>
                      </g>
                    );
                  })}

                  {/* Area Fill Under Asymmetric Polyline */}
                  <path
                    d={areaPath}
                    fill="url(#asymmetricFill)"
                    style={{ transition: 'd 0.3s cubic-bezier(0.16, 1, 0.3, 1)' }}
                  />

                  {/* Connected Polyline Segments */}
                  <path
                    d={polylinePath}
                    fill="none"
                    stroke={themeColor.stroke}
                    strokeWidth="2.8"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    style={{ transition: 'all 0.3s cubic-bezier(0.16, 1, 0.3, 1)' }}
                  />

                  {/* 12 Non-Colorful Cohesive Nodes matching themeColor */}
                  {points.map((p, idx) => {
                    const isHovered = hoveredIndex === idx;
                    const isQ = p.isQuarterNode;

                    return (
                      <g key={`node-${idx}`}>
                        {/* Outer Glow Halo */}
                        <circle
                          cx={p.x}
                          cy={p.y}
                          r={isHovered ? 9 : isQ ? 6.5 : 5}
                          fill={themeColor.stroke}
                          opacity={isHovered ? 0.5 : isQ ? 0.3 : 0.18}
                          style={{ transition: 'all 0.25s ease' }}
                        />
                        {/* Solid Inner Dot */}
                        <circle
                          cx={p.x}
                          cy={p.y}
                          r={isHovered ? 5.5 : isQ ? 4 : 3.2}
                          fill={themeColor.stroke}
                          stroke={isLightMode ? '#ffffff' : '#0A0A0C'}
                          strokeWidth={isHovered ? 2.5 : 1.75}
                          style={{ transition: 'all 0.25s ease' }}
                        />
                      </g>
                    );
                  })}

                  {/* Extended Dotted X-Axis Line directly above Q1, Q2, Q3, Q4 */}
                  <line
                    x1={padding.left}
                    y1={padding.top + graphHeight}
                    x2={padding.left + graphWidth}
                    y2={padding.top + graphHeight}
                    stroke={isLightMode ? 'rgba(0,0,0,0.22)' : 'rgba(255,255,255,0.22)'}
                    strokeWidth="1.5"
                    strokeDasharray="4 4"
                  />

                  {/* Evenly Spaced Ticks for all 12 Months along the Dotted X-Axis */}
                  {points.map((p, idx) => {
                    const isQuarter = idx === 2 || idx === 5 || idx === 8 || idx === 11;
                    return (
                      <line
                        key={`x-tick-${idx}`}
                        x1={p.x}
                        y1={padding.top + graphHeight}
                        x2={p.x}
                        y2={padding.top + graphHeight + (isQuarter ? 6 : 3)}
                        stroke={
                          isQuarter
                            ? isLightMode
                              ? 'rgba(0,0,0,0.45)'
                              : 'rgba(255,255,255,0.55)'
                            : isLightMode
                            ? 'rgba(0,0,0,0.15)'
                            : 'rgba(255,255,255,0.15)'
                        }
                        strokeWidth={isQuarter ? 1.5 : 1}
                      />
                    );
                  })}

                  {/* Q1, Q2, Q3, Q4 Labels Aligned Directly Beneath 3rd, 6th, 9th, and 12th Nodes */}
                  {[
                    { label: 'Q1', x: points[2]?.x ?? (padding.left + graphWidth * (2 / 11)), centerIndex: 2, quarterMonths: [0, 1, 2] },
                    { label: 'Q2', x: points[5]?.x ?? (padding.left + graphWidth * (5 / 11)), centerIndex: 5, quarterMonths: [3, 4, 5] },
                    { label: 'Q3', x: points[8]?.x ?? (padding.left + graphWidth * (8 / 11)), centerIndex: 8, quarterMonths: [6, 7, 8] },
                    { label: 'Q4', x: points[11]?.x ?? (padding.left + graphWidth), centerIndex: 11, quarterMonths: [9, 10, 11] },
                  ].map((q) => {
                    const isHovered = hoveredIndex !== null && q.quarterMonths.includes(hoveredIndex);
                    return (
                      <g
                        key={q.label}
                        className="cursor-pointer"
                        onMouseEnter={() => setHoveredIndex(q.centerIndex)}
                        onMouseLeave={() => setHoveredIndex(null)}
                      >
                        {/* Interactive Click/Hover Hitbox */}
                        <rect
                          x={q.x - 30}
                          y={padding.top + graphHeight + 2}
                          width="60"
                          height="28"
                          fill="transparent"
                        />
                        <text
                          x={q.x}
                          y={padding.top + graphHeight + 20}
                          textAnchor="middle"
                          className="font-mono text-[11.5px] select-none transition-colors duration-200"
                          fill={
                            isHovered
                              ? themeColor.stroke
                              : isLightMode
                              ? 'rgba(0,0,0,0.6)'
                              : 'rgba(255,255,255,0.6)'
                          }
                          style={{
                            fontWeight: isHovered ? 700 : 600,
                          }}
                        >
                          {q.label}
                        </text>
                      </g>
                    );
                  })}

                  {/* Hover Cursor Vertical Guide Line & Active Vertex Indicator */}
                  {activePoint && (
                    <g>
                      <line
                        x1={activePoint.x}
                        y1={padding.top}
                        x2={activePoint.x}
                        y2={padding.top + graphHeight}
                        stroke={isLightMode ? 'rgba(0,0,0,0.25)' : 'rgba(255,255,255,0.3)'}
                        strokeDasharray="2 2"
                      />
                      {/* Active Node Pulse */}
                      <circle
                        cx={activePoint.x}
                        cy={activePoint.y}
                        r="11"
                        fill={themeColor.stroke}
                        opacity="0.35"
                      />
                      <circle
                        cx={activePoint.x}
                        cy={activePoint.y}
                        r="5.5"
                        fill={themeColor.stroke}
                        stroke={isLightMode ? '#ffffff' : '#0A0A0C'}
                        strokeWidth="2.5"
                      />
                    </g>
                  )}

                  {/* Tooltip Hover Box directly on top of the active/hovered node */}
                  {activePoint && hoveredIndex !== null && (
                    <g
                      className="pointer-events-none transition-transform duration-100"
                      transform={`translate(${Math.min(Math.max(activePoint.x, 90), svgWidth - 90)}, ${Math.max(activePoint.y - 54, 20)})`}
                    >
                      {/* Tooltip Card Background */}
                      <rect
                        x="-85"
                        y="-24"
                        width="170"
                        height="46"
                        rx="8"
                        fill={isLightMode ? '#ffffff' : '#141418'}
                        stroke={isLightMode ? 'rgba(0, 0, 0, 0.15)' : 'rgba(255, 255, 255, 0.2)'}
                        strokeWidth="1.2"
                        filter="drop-shadow(0 4px 14px rgba(0,0,0,0.25))"
                      />
                      {/* Downward Caret Triangle */}
                      <path
                        d="M -5 22 L 0 27 L 5 22 Z"
                        fill={isLightMode ? '#ffffff' : '#141418'}
                        stroke={isLightMode ? 'rgba(0, 0, 0, 0.15)' : 'rgba(255, 255, 255, 0.2)'}
                        strokeWidth="1.2"
                      />
                      <line
                        x1="-4.5"
                        y1="22"
                        x2="4.5"
                        y2="22"
                        stroke={isLightMode ? '#ffffff' : '#141418'}
                        strokeWidth="2"
                      />
                      {/* Month Label */}
                      <text
                        x="0"
                        y="-6"
                        textAnchor="middle"
                        className="font-mono text-[10.5px] uppercase tracking-wider font-semibold"
                        fill={isLightMode ? '#111111' : '#ffffff'}
                      >
                        {activePoint.label}
                      </text>
                      {/* Compound Reputation Decay Value */}
                      <text
                        x="0"
                        y="9"
                        textAnchor="middle"
                        className="font-mono text-[11px] font-bold"
                        fill={themeColor.stroke}
                      >
                        Decay: ${activePoint.monthlyLoss.toLocaleString()}/mo
                      </text>
                    </g>
                  )}
                </svg>
              </div>

              {/* Metrics Text directly inside the graph box just beneath the line graph */}
              <div className="mt-4 sm:mt-5 pt-3.5 sm:pt-4 border-t border-black/[0.06] dark:border-white/[0.08] grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6 items-center font-mono select-none">
                {/* Metric 1: Monthly Revenue Leakage */}
                <div className="flex items-center justify-between sm:justify-start gap-2">
                  <span className={`text-[11px] sm:text-xs uppercase tracking-wider ${isLightMode ? 'text-neutral-500' : 'text-neutral-400'}`}>
                    Monthly Revenue Leakage:
                  </span>
                  <span className="font-bold text-sm sm:text-base tracking-tight" style={{ color: themeColor.stroke }}>
                    <NumberTicker value={monthlyRevenueLeakage} prefix="$" duration={900} />
                    <span className={`text-xs font-normal ml-0.5 ${isLightMode ? 'text-neutral-500' : 'text-neutral-400'}`}>/mo</span>
                  </span>
                </div>

                {/* Metric 2: Annualized Pipeline Risk */}
                <div className="flex items-center justify-between sm:justify-center gap-2">
                  <span className={`text-[11px] sm:text-xs uppercase tracking-wider ${isLightMode ? 'text-neutral-500' : 'text-neutral-400'}`}>
                    Annualized Pipeline Risk:
                  </span>
                  <span className={`font-bold text-sm sm:text-base tracking-tight ${isLightMode ? 'text-black' : 'text-white'}`}>
                    <NumberTicker value={annualLeakage} prefix="$" duration={900} />
                    <span className={`text-xs font-normal ml-0.5 ${isLightMode ? 'text-neutral-500' : 'text-neutral-400'}`}>/yr</span>
                  </span>
                </div>

                {/* Metric 3: Quarantined Outbound */}
                <div className="flex items-center justify-between sm:justify-end gap-2">
                  <span className={`text-[11px] sm:text-xs uppercase tracking-wider ${isLightMode ? 'text-neutral-500' : 'text-neutral-400'}`}>
                    Quarantined Outbound:
                  </span>
                  <span className={`font-bold text-sm sm:text-base tracking-tight ${isLightMode ? 'text-black' : 'text-white'}`}>
                    ~<NumberTicker value={quarantinedMessages} duration={900} />
                    <span className={`text-xs font-normal ml-1 ${isLightMode ? 'text-neutral-500' : 'text-neutral-400'}`}>emails</span>
                  </span>
                </div>
              </div>
            </div>
          </div>

        {/* Interactive Parameter Sliders */}
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6 pt-2 max-w-5xl mx-auto">
          {/* Slider 1: Monthly Outbound (min: 1,000, max: 100,000, default: 10,000) */}
          <div
            className={`rc-grain-surface p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border backdrop-blur-md transition-all duration-200 ${
              isLightMode
                ? 'bg-black/[0.02] border-black/[0.07]'
                : 'bg-white/[0.03] border-white/[0.08]'
            }`}
          >
            <div className="flex justify-between items-center text-xs font-mono mb-3">
              <span className={isLightMode ? 'text-neutral-700 font-medium' : 'text-neutral-300 font-medium'}>
                Monthly Outbound
              </span>
              <span
                className={`font-mono text-xs px-2 py-0.5 rounded-md ${
                  isLightMode ? 'bg-black/5 text-black font-semibold' : 'bg-white/10 text-white font-semibold'
                }`}
              >
                {outboundVolume.toLocaleString()}
              </span>
            </div>
            <input
              type="range"
              min={1000}
              max={100000}
              step={1000}
              value={outboundVolume}
              onChange={(e) => setOutboundVolume(Number(e.target.value))}
              className={`w-full h-1.5 rounded-lg appearance-none cursor-pointer ${
                isLightMode ? 'bg-neutral-200 accent-black' : 'bg-neutral-800 accent-white'
              }`}
            />
            <div className="flex justify-between text-[10px] font-mono text-neutral-400 mt-2">
              <span>1,000</span>
              <span>100,000</span>
            </div>
          </div>

          {/* Slider 2: Quarantine / Spam Rate (min: 1%, max: 65%, default: 35%) */}
          <div
            className={`rc-grain-surface p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border backdrop-blur-md transition-all duration-200 ${
              isLightMode
                ? 'bg-black/[0.02] border-black/[0.07]'
