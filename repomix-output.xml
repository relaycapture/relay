                  </div>

                  {/* Gmail Category Tabs */}
                  <div className="flex items-center gap-2">
                    <div
                      className={`flex items-center gap-2 px-3 py-1.5 rounded-lg font-medium text-xs cursor-pointer ${
                        viewState === 'after'
