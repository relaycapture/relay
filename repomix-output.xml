// Varied organic delays for striking out cards in Before mode
const VARIED_STRIKE_DELAYS = [
  0, 140, 290, 460, 650, 870, 1120, 1400, 1710, 2050, 2420, 2820, 3250, 3710, 4200
];

export function InboxComparison({ isLightMode, isLivePreview = false, currentDomain }: InboxComparisonProps) {
  const [viewState, setViewState] = useState<'before' | 'after'>('before');
  const [selectedFolder, setSelectedFolder] = useState<'inbox' | 'spam'>('spam');

  // Animation Phase State Machine:
  // 0: Before mode (cards struck through in red)
  // 1: Phase 1 (0s) - Base cards instantly un-cross and turn white/normal
  // 2: Phase 2 (0.98s) - Interleaved green cards slide in
  // 3: Phase 3 (2.45s) - Top surge green cards slide in at the very top
  const [animationPhase, setAnimationPhase] = useState<number>(0);

  // Staggered crossed-out status for Before mode (all initialized to struck)
  const [struckIndices, setStruckIndices] = useState<Set<number>>(() => {
    const allSpamList = [...BASE_EMAILS, ...BEFORE_SPAM_EXTRA_EMAILS];
    return new Set(allSpamList.map((_, i) => i));
  });

  // Smooth Counter Numbers initialized to BEFORE STATE:
  // BEFORE STATE : Inbox: 8,562 (57.08%) | Spam: 6,438 (42.92%)
  const [counts, setCounts] = useState({
    inbox: 8562,
    inboxPct: 57.08,
    spam: 6438,
    spamPct: 42.92,
  });

  const timeoutsRef = useRef<NodeJS.Timeout[]>([]);

  const clearAllTimeouts = () => {
    timeoutsRef.current.forEach(clearTimeout);
    timeoutsRef.current = [];
  };

  // Smooth Numeric Interpolation with increased duration
  const animateNumbers = (toAfter: boolean) => {
    const startInbox = counts.inbox;
    const startInboxPct = counts.inboxPct;
    const startSpam = counts.spam;
    const startSpamPct = counts.spamPct;

    const targetInbox = toAfter ? 14973 : 8562;
    const targetInboxPct = toAfter ? 99.82 : 57.08;
    const targetSpam = toAfter ? 27 : 6438;
    const targetSpamPct = toAfter ? 0.18 : 42.92;

    const duration = 1350; // ms
    const startTime = performance.now();

    const update = (now: number) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Ease out cubic
      const ease = 1 - Math.pow(1 - progress, 3);

      setCounts({
        inbox: Math.round(startInbox + (targetInbox - startInbox) * ease),
        inboxPct: Number((startInboxPct + (targetInboxPct - startInboxPct) * ease).toFixed(2)),
        spam: Math.round(startSpam + (targetSpam - startSpam) * ease),
        spamPct: Number((startSpamPct + (targetSpamPct - startSpamPct) * ease).toFixed(2)),
      });

      if (progress < 1) {
        requestAnimationFrame(update);
      }
    };

    requestAnimationFrame(update);
  };

  // Handle Switching between BEFORE and AFTER with increased & varied delays
  const handleToggle = (targetState: 'before' | 'after') => {
    if (targetState === viewState) return;

    clearAllTimeouts();
    setViewState(targetState);
    animateNumbers(targetState === 'after');

    if (targetState === 'after') {
      setSelectedFolder('inbox');
      setStruckIndices(new Set());

      // Phase 1 (Immediate / t = 0s): Un-cross base cards
      setAnimationPhase(1);

      // Phase 2 (Increased delay: ~0.98s): Slide in interleaved green cards
      const t1 = setTimeout(() => {
        setAnimationPhase(2);
      }, 980);
      timeoutsRef.current.push(t1);

      // Phase 3 (Increased delay: ~2.45s): Slide in top surge green cards
      const t2 = setTimeout(() => {
        setAnimationPhase(3);
      }, 2450);
      timeoutsRef.current.push(t2);
    } else {
      setSelectedFolder('spam');
      // Set phase to 0 immediately so green cards exit
      setAnimationPhase(0);

      // Stagger cross out all spam cards one by one with varied delays
      const allSpamList = [...BASE_EMAILS, ...BEFORE_SPAM_EXTRA_EMAILS];
      allSpamList.forEach((_, idx) => {
        const delay = VARIED_STRIKE_DELAYS[idx] ?? (idx * 270);
        const t = setTimeout(() => {
          setStruckIndices((prev) => new Set(prev).add(idx));
        }, delay);
        timeoutsRef.current.push(t);
      });
    }
  };

  // Cleanup on unmount
  useEffect(() => {
    return () => clearAllTimeouts();
  }, []);

  // Construct Email List based on Animation Phase State Machine
  const getDisplayedEmails = (): SimulatedEmail[] => {
    if (viewState === 'before' || animationPhase === 0) {
      // In BEFORE mode, include all base emails + extra spam cards (12 emails)
      return [...BASE_EMAILS, ...BEFORE_SPAM_EXTRA_EMAILS];
    }

    if (animationPhase === 1) {
      // Phase 1: Only base cards (un-crossed) (8 emails)
      return BASE_EMAILS;
    }

    if (animationPhase === 2) {
      // Phase 2: Interleaved green cards between base cards (10 emails)
      return [
        BASE_EMAILS[0],
        PHASE2_INTERLEAVED_EMAILS[0], // Microsoft
        BASE_EMAILS[1],
        PHASE2_INTERLEAVED_EMAILS[1], // Vanta SOC2
        ...BASE_EMAILS.slice(2),
      ];
    }

    // Phase 3: Top surge green cards at top + interleaved + base cards (12 emails)
    return [
      PHASE3_TOP_SURGE_EMAILS[0], // JPMorgan Chase Fedwire
      PHASE3_TOP_SURGE_EMAILS[1], // Goldman Sachs Custody
      BASE_EMAILS[0],
      PHASE2_INTERLEAVED_EMAILS[0], // Microsoft
      BASE_EMAILS[1],
      PHASE2_INTERLEAVED_EMAILS[1], // Vanta SOC2
      ...BASE_EMAILS.slice(2),
    ];
  };

  const displayedEmails = getDisplayedEmails();
  const activeFolder = viewState === 'before' ? 'spam' : selectedFolder;

  return (
    <section
      id="inbox-comparison"
      className={`relative px-4 sm:px-8 md:px-12 lg:px-24 overflow-hidden z-10 ${
        isLivePreview ? 'py-6' : 'py-20 sm:py-28 md:py-36 section-content-auto'
      }`}
    >
      {/* Background Ambience */}
      <div className="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <div
          className={`absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[85vw] h-[45vw] rounded-full blur-[180px] pointer-events-none transition-opacity ${
            isLightMode ? 'bg-neutral-200/40 opacity-30' : 'bg-white/[0.02] opacity-20'
          }`}
        />
      </div>

      <div className="relative z-10 max-w-6xl mx-auto">
        {/* Section Heading */}
        <div className="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
          <h2
            className={`text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.03em] leading-[1.15] mb-3 ${
              isLightMode ? 'text-[#1d1d1f]' : 'text-white'
            }`}
          >
            Same email. Two destinations.
          </h2>
          <p
            className={`text-xs sm:text-base md:text-lg font-normal leading-relaxed max-w-2xl mx-auto ${
              isLightMode ? 'text-neutral-600' : 'text-neutral-400'
            }`}
          >
            Toggle between unauthenticated sending posture and full RFC 7489 cryptographic enforcement to see how Google Workspace and Microsoft 365 process your transactional emails.
          </p>
        </div>

        {/* Attached Exterior Control Dock attached directly above the Gmail window */}
        <div className="flex justify-center -mb-2 relative z-20 w-full max-w-full overflow-hidden px-1 sm:px-0">
          <div
            className="inline-flex items-center p-1 sm:p-1.5 rounded-t-2xl border-t border-x shadow-2xl backdrop-blur-2xl transition-all w-full sm:w-auto max-w-full"
            style={{
              backgroundColor: isLightMode ? '#f0f3f8' : '#16161b',
              borderColor: isLightMode ? 'rgba(0,0,0,0.12)' : 'rgba(255,255,255,0.12)',
            }}
          >
            <button
              id="inbox-toggle-before-btn"
              data-cursor="grow"
              onClick={() => handleToggle('before')}
              className={`rc-grain-surface flex-1 sm:flex-initial px-3 sm:px-5 py-3 sm:py-2.5 rounded-xl text-[11px] sm:text-sm font-semibold transition-all flex items-center justify-center gap-1.5 sm:gap-2 truncate min-h-[48px] ${
                viewState === 'before'
                  ? 'bg-rose-500/20 text-rose-500 border border-rose-500/40 shadow-sm'
                  : isLightMode
                  ? 'text-neutral-600 hover:text-black'
                  : 'text-neutral-400 hover:text-white'
              }`}
            >
              <AlertOctagon className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-rose-500 flex-shrink-0" />
              <span className="truncate">
                <span className="sm:hidden">BEFORE (Spam)</span>
                <span className="hidden sm:inline">BEFORE: Spam Quarantine</span>
