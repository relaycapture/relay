            {/* Right Pane: Framer Motion Animated Email Rows */}
            <div className="flex-1 flex flex-col justify-between overflow-hidden relative">
              <div className="flex-1 overflow-y-auto relative [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                {/* Gmail Top Action Bar & Tabs */}
                <div
                  className={`sticky top-0 z-10 px-4 py-2 border-b flex items-center justify-between gap-4 text-xs select-none backdrop-blur-md ${
                    isLightMode ? 'bg-[#fafafc]/95 border-black/[0.06]' : 'bg-[#16161a]/95 border-white/[0.06]'
