  return (
    <section
      id="pricing-teaser"
      className={`relative py-16 sm:py-24 px-4 sm:px-8 md:px-12 lg:px-24 overflow-hidden z-10 transition-colors ${
        isLightMode ? 'bg-[#fbfbfd]' : 'bg-[#09090C]'
