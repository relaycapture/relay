@import "tailwindcss";

@layer base {
  :root {
    --font-sans: 'Geist', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-teleport: cubic-bezier(0.83, 0, 0.17, 1);
  }

  html,
  body,
  button,
  a,
  input,
  select,
  textarea,
  [role="button"],
  iframe,
  * {
    cursor: none !important;
  }

  @media (hover: none) and (pointer: coarse) {
    html,
    body,
    button,
    a,
    input,
    select,
    textarea,
    [role="button"],
    iframe,
    * {
      cursor: auto !important;
    }
  }

  html {
    font-family: var(--font-sans);
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  /* When reduced motion is requested */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* On mobile touch devices, restore standard cursor */
  @media (pointer: coarse) {
    html, body, button, a, input, select, textarea, [role="button"], iframe, * {
      cursor: auto !important;
    }
  }
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: #0a0a0c;
}
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(34, 211, 238, 0.4);
}

/* Grain animation */
@keyframes rc-grain {
  0%, 100% { transform: translate(0, 0); }
  10% { transform: translate(-3%, -2%); }
  20% { transform: translate(-6%, 3%); }
  30% { transform: translate(4%, -5%); }
  40% { transform: translate(-2%, 6%); }
  50% { transform: translate(-5%, 2%); }
  60% { transform: translate(3%, 5%); }
  70% { transform: translate(5%, 1%); }
  80% { transform: translate(-3%, 4%); }
  90% { transform: translate(2%, -4%); }
}

@keyframes scan-line {
  0% { transform: translateY(-100%); opacity: 0; }
  15% { opacity: 0.8; }
  85% { opacity: 0.8; }
  100% { transform: translateY(1000%); opacity: 0; }
}

@keyframes pulse-subtle {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.04); }
}

.animate-scan-line {
  animation: scan-line 6s linear infinite;
}

.animate-pulse-subtle {
  animation: pulse-subtle 4s ease-in-out infinite;
}

/* Tactile Grain / Roughness texture overlay for buttons, boxes, and cards */
.rc-grain-surface {
  position: relative;
}

.rc-grain-surface::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0.055;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  background-size: 140px 140px;
  mix-blend-mode: overlay;
  z-index: 1;
}

@keyframes slide-in-right {
  0% {
    opacity: 0;
    transform: translateX(40px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

.animate-slide-in-right {
  animation: slide-in-right 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeIn {
  0% {
    opacity: 0;
    transform: translateY(4px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Glass panel utility */
.glass-panel {
  background: rgba(10, 10, 12, 0.55);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.glass-panel-light {
  background: rgba(244, 244, 242, 0.65);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

/* Off-screen layout skipping for below-the-fold sections */
.section-content-auto {
  content-visibility: auto;
  contain-intrinsic-size: 1px 800px;
}

/* Mobile & low-power device blur optimizations to avoid fill-rate bottlenecks */
@media (max-width: 768px) {
  .glass-panel,
  .glass-panel-light {
    backdrop-filter: blur(10px) saturate(140%) !important;
    -webkit-backdrop-filter: blur(10px) saturate(140%) !important;
  }
}
